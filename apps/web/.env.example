# Supabase project used by the web app. Copy this file to .env.local and fill it in:
# Supabase dashboard → Project Settings → API Keys.
# Both values are public (they reach the browser); never put the secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY

# Public address of the website, without a trailing slash. Used for canonical links, the
# image shown when sharing the landing, robots.txt and the sitemap. Locally it can stay empty.
NEXT_PUBLIC_SITE_URL=

# Demo account used to record the landing video and screenshots (scripts/landing-media).
# Any new email and password: the script creates the account if it does not exist.
LANDING_DEMO_EMAIL=
LANDING_DEMO_PASSWORD=
