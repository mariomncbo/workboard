<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Plantilla de configuración de Supabase.
  Cópiala a WorkBoard/Config/Secrets.plist (no se versiona) y rellena los valores
  de tu proyecto: Supabase → Project Settings → API.
-->
<plist version="1.0">
<dict>
	<key>SupabaseURL</key>
	<string>https://YOUR-PROJECT-REF.supabase.co</string>
	<key>SupabasePublishableKey</key>
	<string>sb_publishable_YOUR-KEY</string>
</dict>
</plist>
